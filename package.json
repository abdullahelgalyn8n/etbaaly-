{
  "name": "etbaaly-platform",
  "version": "1.0.0",
  "description": "Etbaaly (إطبعلي) - Custom Printing, Packaging Manufacturing & Merch Platform by A.Z Agency",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "node --max-old-space-size=4096 ./node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "preview:worker": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.147.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "*",
    "@emnapi/wasi-threads": "^2.0.1"
  },
  "browserslist": [
    "chrome >= 100",
    "edge >= 100",
    "firefox >= 100",
    "safari >= 15.4",
    "ios >= 15.4",
    "not dead"
  ]
}
