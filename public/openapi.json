              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "recipient": "0x0113c23eF5d3269F39b03F80905e32B945398d5a"
            }
          ]
        }
      }
    },
    "/api": {
      "get": {
        "summary": "Agent Gateway Root",
        "description": "Agent-native commercial gateway protected by x402 and MPP micropayment protocols.",
        "operationId": "getAgentGatewayRoot",
        "responses": {
          "200": {
            "description": "Payment successful - access granted to commercial API."
          },
          "402": {
            "description": "Payment Required via x402 or MPP protocol."
          }
        },
        "x-payment-info": {
          "intent": "charge",
          "method": "tempo",
          "amount": "0.01",
          "currency": "USD",
          "description": "Agent micro-charge for commercial print & packaging API gateway access",
          "offers": [
            {
              "intent": "charge",
              "method": "tempo",
              "amount": "0.01",
              "currency": "USD"
            },
            {
              "intent": "charge",
              "method": "stripe",
              "amount": "0.01",
              "currency": "USD"
            },
            {
              "intent": "charge",
              "method": "x402:exact",
              "scheme": "exact",
              "network": "eip155:8453",
              "amount": "0.01",
              "currency": "USDC",
              "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
              "recipient": "0x0113c23eF5d3269F39b03F80905e32B945398d5a"
            }
          ]
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "List products",
        "description": "Retrieve the catalog of custom printing products, packaging boxes, stickers, apparel, and promotional items.",
        "operationId": "getProducts",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter products by category slug (e.g. stickers, packaging-boxes, apparel, corporate-stationery, or all).",
            "schema": {
              "type": "string",
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved products catalog.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "count": { "type": "integer" },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "name": { "type": "string" },
                          "slug": { "type": "string" },
                          "category": { "type": "string" },
                          "price": { "type": "number" },
                          "description": { "type": "string" },
                          "imageUrl": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "summary": "List blog posts and printing guides",
        "description": "Retrieve articles, printing technical guides, and packaging advice with optional category, search, and pagination parameters.",
        "operationId": "getPosts",
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": false,
            "description": "Lookup a single post by its URL slug.",
            "schema": { "type": "string" }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter posts by category.",
            "schema": { "type": "string", "default": "all" }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search keyword matching title, excerpt, or content.",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination.",
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of articles per page.",
            "schema": { "type": "integer", "default": 10 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of articles or single article details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "posts": { "type": "array" },
                    "pagination": { "type": "object" },
                    "stats": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Article not found when requested by slug."
          }
        }
      }
    },
    "/api/orders/track": {
      "get": {
        "summary": "Track print order status",
        "description": "Get real-time tracking information, production milestone progress, and shipping updates for an order.",
        "operationId": "trackOrder",
        "parameters": [
          {
            "name": "orderNumber",
            "in": "query",
            "required": true,
            "description": "The unique order number (e.g. ETB-12345).",
            "schema": { "type": "string" }
          },
          {
            "name": "phone",
            "in": "query",
            "required": false,
            "description": "Customer phone number verification.",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Order tracking details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "order": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found."
          }
        }
      }
    },
    "/api/shipping": {
      "post": {
        "summary": "Calculate shipping rates",
        "description": "Compute shipping cost and estimated delivery time across Egypt's 27 governorates.",
        "operationId": "calculateShipping",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["governorate"],
                "properties": {
                  "governorate": {
                    "type": "string",
                    "description": "Name of the Egyptian governorate (in Arabic or English, e.g. Cairo, Giza, Alexandria)."
                  },
                  "subtotal": {
                    "type": "number",
                    "description": "Cart subtotal to check for free shipping eligibility."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shipping rate calculation result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "cost": { "type": "number" },
                    "estimatedDays": { "type": "string" },
                    "freeShipping": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/quotes": {
      "post": {
        "summary": "Request custom printing quote",
        "description": "Submit a request for quote for custom packaging boxes, offset printing runs, or bespoke corporate merchandise.",
        "operationId": "submitQuote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "phone", "serviceType"],
                "properties": {
                  "name": { "type": "string" },
                  "phone": { "type": "string" },
                  "email": { "type": "string" },
                  "company": { "type": "string" },
                  "serviceType": { "type": "string" },
                  "quantity": { "type": "integer" },
                  "specifications": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote request received successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "message": { "type": "string" },
                    "quoteId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "API health and status check",
        "description": "Returns operational status, uptime, and service health per RFC 8631 / RFC 9727 status relation.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy and fully operational.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "pass" },
                    "healthy": { "type": "boolean", "example": true },
                    "service": { "type": "string", "example": "etbaaly-api" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/token": {
      "post": {
        "summary": "OAuth 2.0 Token Endpoint",
        "description": "Issues access tokens for authorized agents or clients using standard grant types (client_credentials, authorization_code, refresh_token).",
        "operationId": "oauthToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": { "type": "string", "enum": ["client_credentials", "authorization_code", "refresh_token"] },
                  "client_id": { "type": "string" },
                  "client_secret": { "type": "string" },
                  "code": { "type": "string" },
                  "scope": { "type": "string", "default": "api:read" }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["grant_type"],
                "properties": {
                  "grant_type": { "type": "string", "enum": ["client_credentials", "authorization_code", "refresh_token"] },
                  "client_id": { "type": "string" },
                  "client_secret": { "type": "string" },
                  "code": { "type": "string" },
                  "scope": { "type": "string", "default": "api:read" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "token_type": { "type": "string", "example": "Bearer" },
                    "expires_in": { "type": "integer", "example": 3600 },
                    "scope": { "type": "string", "example": "api:read" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid OAuth 2.0 request or unsupported grant type."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "OAuth 2.0 / OIDC authentication for agents",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://etbaaly.azagency.online/api/auth/token",
            "scopes": {
              "api:read": "Read access to public catalog, quotes, and tracking",
              "api:write": "Create quotes and place orders"
            }
          }
        }
      },
      "paymentAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Payment authorization header for MPP (Machine Payment Protocol) and x402 micropayments"
      }
    }
  }
}
