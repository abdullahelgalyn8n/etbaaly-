{
  "openapi": "3.1.0",
  "info": {
    "title": "إطبعلي | Etbaaly Printing & Packaging API",
    "version": "1.0.0",
    "description": "Public API for Etbaaly (إطبعلي), powered by A.Z Agency. Provides machine-readable access to products, blog articles, order tracking, quotes, and shipping rates for custom printing, packaging manufacturing, and print-on-demand services in Egypt and the MENA region.",
    "contact": {
      "name": "Etbaaly Support",
      "url": "https://etbaaly.azagency.online/contact",
      "email": "print@azagency.online"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://etbaaly.azagency.online/terms"
    }
  },
  "servers": [
    {
      "url": "https://etbaaly.azagency.online",
      "description": "Production Server"
    }
  ],
  "x-service-info": {
    "name": "Etbaaly Agent Commerce",
    "description": "Commercial printing and packaging manufacturing agent API",
    "categories": ["e-commerce", "printing", "manufacturing", "business"]
  },
  "paths": {
    "/api/v1": {
      "get": {
        "summary": "Agent Gateway v1",
        "description": "Agent-native commercial gateway protected by x402 and MPP micropayment protocols.",
        "operationId": "getAgentGatewayV1",
        "responses": {
          "200": {
            "description": "Payment successful - access granted to commercial API."
          },
          "402": {
            "description": "Payment Required via x402 or MPP protocol."
          }
        },
        "x-payment-info": {
          "intent": "charge",
          "method": "tempo",
          "amount": "0.01",
          "currency": "USD",
          "description": "Agent micro-charge for commercial print & packaging API gateway access",
          "offers": [
            {
              "intent": "charge",
              "method": "tempo",
              "amount": "0.01",
              "currency": "USD"
            },
            {
              "intent": "charge",
              "method": "stripe",
              "amount": "0.01",
              "currency": "USD"
            },
            {
              "intent": "charge",
              "method": "x402:exact",
