{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etbaaly",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "etbaaly"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://etbaaly.azagency.online",
    "NEXT_PUBLIC_SUPABASE_URL": "https://dvkbfckmtovvoybnytix.supabase.co",
    "NEXT_PUBLIC_FB_PIXEL_ID": "1630628135121340"
  }
}
